<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GUI"
        x:Class="GUI.MessageDialog"
        Icon="avares://CS2WorkshopManager-GUI/assets/icon.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RadGenAppBrush}">
    <Panel>
        <!-- the main window's gradient in the colour of the news: the accent for information, amber for warnings, red for destructive questions -->
        <local:DitheredGradient Name="InfoGradient" CenterColor="{DynamicResource RadGenAppAccentColor}" EdgeColor="{DynamicResource RadGenAppColor}" GradientOrigin="105%,-1%" />
        <local:DitheredGradient Name="WarningGradient" IsVisible="False" CenterColor="{DynamicResource RadGenAppWarningColor}" EdgeColor="{DynamicResource RadGenAppColor}" GradientOrigin="105%,-1%" />
        <local:DitheredGradient Name="DangerGradient" IsVisible="False" CenterColor="{DynamicResource RadGenAppDangerColor}" EdgeColor="{DynamicResource RadGenAppColor}" GradientOrigin="105%,-1%" />

        <StackPanel Margin="20" Spacing="16" MaxWidth="540">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image Name="Symbol" Width="96" Height="96" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                <TextBlock Name="Message" TextWrapping="Wrap" MaxWidth="440" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Name="YesButton" Content="Yes" MinWidth="80" Click="OnYes" />
                <Button Name="NoButton" Content="No" MinWidth="80" Click="OnNo" />
                <Button Name="OkButton" Content="OK" MinWidth="80" Click="OnYes" />
            </StackPanel>
        </StackPanel>
    </Panel>
</Window>
