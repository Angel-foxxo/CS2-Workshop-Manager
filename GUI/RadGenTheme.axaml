<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- RadGen's dark and light palettes, https://github.com/Angel-foxxo/RadGen, on top of the Fluent theme's resource keys -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="RadGenAppColor">#D7D7D7</Color>
            <Color x:Key="RadGenAppSoftColor">#D0D0D0</Color>
            <Color x:Key="RadGenBorderColor">#ACACAC</Color>
            <Color x:Key="RadGenBorderSoftColor">#919191</Color>
            <Color x:Key="RadGenContrastColor">#000000</Color>
            <Color x:Key="RadGenContrastSoftColor">#6E6E6E</Color>
            <Color x:Key="RadGenAccentColor">#2EACD4</Color>
            <!-- the main colour a quarter of the way to the accent, for the window gradient -->
            <Color x:Key="RadGenAppAccentColor">#ADCCD6</Color>
            <!-- the main colour a third of the way to red, for the gradient behind destructive prompts -->
            <Color x:Key="RadGenAppDangerColor">#D9A9A9</Color>
            <!-- the main colour a third of the way to amber, for the gradient behind warnings -->
            <Color x:Key="RadGenAppWarningColor">#D9CBA9</Color>
            <!-- what the main views lay over the gradient: light theme lightens, dark theme darkens -->
            <Color x:Key="RadGenShadeColor">#FFFFFF</Color>
            <!-- popups need a solid panel to read over content, and the outlines of fields and check boxes lean towards the accent -->
            <Color x:Key="RadGenPopupColor">#E4EBF1</Color>
            <Color x:Key="RadGenOutlineColor">#8FA3B6</Color>
            <!-- headings in rendered descriptions, the blue Steam gives them -->
            <Color x:Key="RadGenHeadingColor">#1B6AA8</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="RadGenAppColor">#1A1B1E</Color>
            <Color x:Key="RadGenAppSoftColor">#232628</Color>
            <Color x:Key="RadGenBorderColor">#26292B</Color>
            <Color x:Key="RadGenBorderSoftColor">#2D3033</Color>
            <Color x:Key="RadGenContrastColor">#EAEAEA</Color>
            <Color x:Key="RadGenContrastSoftColor">#C4C7CE</Color>
            <Color x:Key="RadGenAccentColor">#3A558C</Color>
            <!-- the main colour a quarter of the way to the accent, for the window gradient -->
            <Color x:Key="RadGenAppAccentColor">#222A3A</Color>
            <!-- the main colour a third of the way to red, for the gradient behind destructive prompts -->
            <Color x:Key="RadGenAppDangerColor">#4E2225</Color>
            <!-- the main colour a third of the way to amber, for the gradient behind warnings -->
            <Color x:Key="RadGenAppWarningColor">#4A3B1E</Color>
            <!-- what the main views lay over the gradient: light theme lightens, dark theme darkens -->
            <Color x:Key="RadGenShadeColor">#000000</Color>
            <!-- popups need a solid panel to read over content, and the outlines of fields and check boxes lean towards the accent -->
            <Color x:Key="RadGenPopupColor">#202735</Color>
            <Color x:Key="RadGenOutlineColor">#3E4B66</Color>
            <!-- headings in rendered descriptions, the blue Steam gives them -->
            <Color x:Key="RadGenHeadingColor">#67C1F5</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="RadGenAppBrush" Color="{DynamicResource RadGenAppColor}" />
    <SolidColorBrush x:Key="RadGenAppSoftBrush" Color="{DynamicResource RadGenAppSoftColor}" />
    <!-- the main views shade the window gradient instead of painting over it -->
    <SolidColorBrush x:Key="RadGenShadeBrush" Color="{DynamicResource RadGenShadeColor}" Opacity="0.2" />
    <SolidColorBrush x:Key="RadGenBorderBrush" Color="{DynamicResource RadGenBorderColor}" />
    <SolidColorBrush x:Key="RadGenBorderSoftBrush" Color="{DynamicResource RadGenBorderSoftColor}" />
    <SolidColorBrush x:Key="RadGenContrastBrush" Color="{DynamicResource RadGenContrastColor}" />
    <SolidColorBrush x:Key="RadGenContrastSoftBrush" Color="{DynamicResource RadGenContrastSoftColor}" />
    <SolidColorBrush x:Key="RadGenAccentBrush" Color="{DynamicResource RadGenAccentColor}" />
    <!-- button faces and the wells of fields are see-through tints, so they take on whatever gradient is behind them like the panels do -->
    <SolidColorBrush x:Key="RadGenControlBrush" Color="{DynamicResource RadGenContrastColor}" Opacity="0.08" />
    <SolidColorBrush x:Key="RadGenControlHoverBrush" Color="{DynamicResource RadGenContrastColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="RadGenFieldBrush" Color="{DynamicResource RadGenShadeColor}" Opacity="0.35" />
    <SolidColorBrush x:Key="RadGenPopupBrush" Color="{DynamicResource RadGenPopupColor}" />
    <SolidColorBrush x:Key="RadGenOutlineBrush" Color="{DynamicResource RadGenOutlineColor}" />
    <SolidColorBrush x:Key="RadGenHeadingBrush" Color="{DynamicResource RadGenHeadingColor}" />


    <!-- windows: main colour with contrast text -->
    <SolidColorBrush x:Key="SystemRegionBrush" Color="{DynamicResource RadGenAppColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource RadGenContrastColor}" />
    <StaticResource x:Key="SystemAccentColor" ResourceKey="RadGenAccentColor" />

    <!-- buttons: a tinted face that brightens under the pointer and turns accent when pressed -->
    <StaticResource x:Key="ButtonBackground" ResourceKey="RadGenControlBrush" />
    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="RadGenControlHoverBrush" />
    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="RadGenAccentBrush" />
    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="RadGenControlBrush" />
    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="RadGenControlHoverBrush" />
    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="RadGenAccentBrush" />

    <!-- text boxes and combo boxes: a dark well with a tinted outline, accent when focused -->
    <StaticResource x:Key="TextControlBackground" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="RadGenOutlineBrush" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="RadGenContrastSoftBrush" />
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="RadGenAccentBrush" />
    <StaticResource x:Key="ComboBoxBackground" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="RadGenControlBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="RadGenControlHoverBrush" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="RadGenOutlineBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="RadGenContrastSoftBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="RadGenAccentBrush" />
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="RadGenPopupBrush" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="RadGenOutlineBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="RadGenControlHoverBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="RadGenAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="RadGenAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="RadGenAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="RadGenAccentBrush" />

    <!-- check boxes: the same well and outline as the fields -->
    <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="RadGenControlBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="RadGenOutlineBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="RadGenContrastSoftBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="RadGenAccentBrush" />

    <!-- popups: flyouts and menus on a tinted panel with the outline colour around them -->
    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="RadGenPopupBrush" />
    <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="RadGenOutlineBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="RadGenPopupBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="RadGenOutlineBrush" />
    <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="RadGenControlHoverBrush" />
    <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="RadGenAccentBrush" />

    <!-- scroll bars and progress: tinted thumbs and a field coloured track -->
    <StaticResource x:Key="ScrollBarThumbFill" ResourceKey="RadGenOutlineBrush" />
    <StaticResource x:Key="ScrollBarThumbFillPointerOver" ResourceKey="RadGenContrastSoftBrush" />
    <StaticResource x:Key="ScrollBarThumbFillPressed" ResourceKey="RadGenAccentBrush" />
    <StaticResource x:Key="ProgressBarBackground" ResourceKey="RadGenFieldBrush" />
    <StaticResource x:Key="ProgressBarForeground" ResourceKey="RadGenAccentBrush" />

    <!-- data grid: soft main colour panel, faded soft contrast grid lines, accent selection -->
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{DynamicResource RadGenShadeColor}" Opacity="0.1" />
    <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{DynamicResource RadGenContrastSoftColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="{DynamicResource RadGenBorderColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{DynamicResource RadGenBorderSoftColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderDraggedBackgroundBrush" Color="{DynamicResource RadGenBorderSoftColor}" />
    <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="{DynamicResource RadGenBorderColor}" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{DynamicResource RadGenAccentColor}" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="{DynamicResource RadGenAccentColor}" />
    <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{DynamicResource RadGenAccentColor}" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{DynamicResource RadGenAccentColor}" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Opacity="0.4" Color="{DynamicResource RadGenContrastSoftColor}" />
    <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="{DynamicResource RadGenBorderSoftColor}" />
    <!-- headers keep no room for a sort arrow until a column is sorted, so labels get the whole column -->
    <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
</ResourceDictionary>
