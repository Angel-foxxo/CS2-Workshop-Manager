<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:GUI"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="GUI.MainWindow"
        Title="CS2 Workshop Manager"
        Icon="avares://CS2WorkshopManager-GUI/assets/icon.ico"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RadGenAppBrush}">
    <Window.Resources>
        <!-- the toolbar's actions on an item again, on a right click over one -->
        <ContextMenu x:Key="ItemMenu">
            <ContextMenu.Styles>
                <Style Selector="Separator">
                    <Setter Property="Margin" Value="8,2" />
                    <Setter Property="Background" Value="{DynamicResource RadGenOutlineBrush}" />
                    <Setter Property="Opacity" Value="0.5" />
                </Style>
            </ContextMenu.Styles>
            <MenuItem Header="Re-Upload" Click="OnReUpload">
                <MenuItem.Icon>
                    <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/reupload.png" Width="18" Height="18" RenderOptions.BitmapInterpolationMode="HighQuality" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Edit" Click="OnEdit">
                <MenuItem.Icon>
                    <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/edit.png" Width="18" Height="18" RenderOptions.BitmapInterpolationMode="HighQuality" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="View" Click="OnView">
                <MenuItem.Icon>
                    <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/view.png" Width="18" Height="18" RenderOptions.BitmapInterpolationMode="HighQuality" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete" Click="OnDelete">
                <MenuItem.Icon>
                    <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/delete.png" Width="18" Height="18" RenderOptions.BitmapInterpolationMode="HighQuality" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Window.Styles>
        <!-- toolbar buttons and the view toggles: icon over label, like the workshop manager's -->
        <Style Selector=":is(Button).tool">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Background" Value="{DynamicResource RadGenShadeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RadGenBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector=":is(Button).tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RadGenBorderSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RadGenBorderSoftBrush}" />
        </Style>
        <Style Selector=":is(Button).tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RadGenAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RadGenAccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RadGenAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RadGenAccentBrush}" />
        </Style>
        <Style Selector=":is(Button).tool StackPanel">
            <Setter Property="Spacing" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).tool Image">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector=":is(Button).tool TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource RadGenContrastBrush}" />
        </Style>

        <!-- tiles are list items so one can be selected, shown by an accent halo in the tile margin -->
        <Style Selector="ListBox#TileItems ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox#TileItems ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RadGenBorderSoftBrush}" />
        </Style>
        <Style Selector="ListBox#TileItems ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RadGenAccentBrush}" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- window background: a subtle glow of the accent fading to the main colour, dithered so it does not band -->
        <local:DitheredGradient CenterColor="{DynamicResource RadGenAppAccentColor}" EdgeColor="{DynamicResource RadGenAppColor}" GradientOrigin="90%,0%" />

    <!-- the item list with its toolbar, or the publish form in its place -->
    <DockPanel Name="Main">
        <TextBlock Name="Status" DockPanel.Dock="Bottom" Margin="12,4,12,8" Foreground="{DynamicResource RadGenContrastBrush}" />

        <DockPanel DockPanel.Dock="Top" Margin="8,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <ToggleButton Name="ListToggle" Classes="tool" IsChecked="True" Click="OnViewToggle">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/list.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="List" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Name="TilesToggle" Classes="tool" Click="OnViewToggle">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/grid.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Tiles" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tool" Click="OnNew">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/new.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Click="OnReUpload">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/reupload.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Re-Upload" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Click="OnEdit">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/edit.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Click="OnView">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/view.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="View" />
                    </StackPanel>
                </Button>
                <Button Name="DeleteButton" Classes="tool" Click="OnDelete">
                    <StackPanel Margin="2">
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/delete.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <Button Name="RefreshButton" Classes="tool" Click="OnRefresh">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/reload.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Click="OnFiles">
                    <StackPanel>
                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/filter.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Pack Filter" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- the two views share the space left by the bars, only one is visible -->
        <Panel>
        <ScrollViewer Name="Tiles" IsVisible="False" Background="{DynamicResource RadGenShadeBrush}">
            <!-- this panel is always the viewport width, which sizes the tiles to whole columns, see OnTilesViewportSizeChanged -->
            <Panel SizeChanged="OnTilesViewportSizeChanged">
                <ListBox Name="TileItems" Margin="4" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" SelectionMode="Single" ContextMenu="{StaticResource ItemMenu}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:WorkshopItemRow">
                        <!-- fixed height so every tile in a row is the same, sized for a two line title or two lines of tags -->
                        <Border Width="256" Height="268" Margin="4" Padding="8" CornerRadius="5" Background="{DynamicResource RadGenShadeBrush}" BorderBrush="{DynamicResource RadGenBorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <local:PreviewImage DockPanel.Dock="Top" Height="135" Source="{Binding Thumbnail}" />
                                <SelectableTextBlock Text="{Binding Title}" DockPanel.Dock="Top" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                <!-- the details sit centered in the room left under the title -->
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SelectableTextBlock Text="{Binding Visibility}" Foreground="{DynamicResource RadGenContrastSoftBrush}" />
                                    <SelectableTextBlock Text="{Binding SizeMegabytes, StringFormat='{}{0:N2} MB'}" Foreground="{DynamicResource RadGenContrastSoftBrush}" />
                                </StackPanel>
                                <SelectableTextBlock Text="{Binding TagsLine}" Foreground="{DynamicResource RadGenContrastSoftBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
        </ScrollViewer>

        <DataGrid Name="PublishedItems"
                  x:DataType="local:WorkshopItemRow"
                  ContextMenu="{StaticResource ItemMenu}"
                  IsReadOnly="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="136"
                  ClipboardCopyMode="None"
                  Background="{DynamicResource RadGenShadeBrush}"
                  BorderThickness="0">
            <DataGrid.Styles>
                <!-- cell text can be selected and copied, so it is wrapped and padded like the plain text cells would be -->
                <Style Selector="DataGridCell SelectableTextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Margin" Value="12,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="DataGridColumnHeader TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <!-- rows are selected as a whole, so the outline the theme draws around the focused cell is only noise -->
                <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="136" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <local:PreviewImage Width="128" Height="128" Margin="4" Source="{Binding Thumbnail}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Title" Width="280" MinWidth="100" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Tags" Width="150" MinWidth="100" SortMemberPath="Tags">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding Tags}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Description" Width="*" MinWidth="200" SortMemberPath="Description">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" MaxLines="6" Margin="8,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Visibility" Width="90" MinWidth="90" SortMemberPath="Visibility">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding Visibility}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Last Updated" Width="150" MinWidth="110" SortMemberPath="LastUpdated">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding LastUpdated, StringFormat='{}{0:MM/dd/yyyy}&#10;{0:HH:mm:ss}'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Date Created" Width="150" MinWidth="110" SortMemberPath="DateCreated">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding DateCreated, StringFormat='{}{0:MM/dd/yyyy}&#10;{0:HH:mm:ss}'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Size" Width="110" MinWidth="70" SortMemberPath="SizeMegabytes">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding SizeMegabytes, StringFormat='{}{0:N2} MB'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Published ID" Width="140" MinWidth="70" SortMemberPath="PublishedFileId">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:WorkshopItemRow">
                            <SelectableTextBlock Text="{Binding PublishedFileId}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Panel>
    </DockPanel>

    <local:SubmissionView Name="Submission" IsVisible="False" />
    </Panel>
</Window>
